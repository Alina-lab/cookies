# Заполните локально. .env исключён из Git. Значения в чат передавать не нужно.
DATALENS_ORG_ID=
# Необязательно: существующий воркбук. Если пусто, скрипт создаст новый.
DATALENS_WORKBOOK_ID=
# Предпочтительно оставить пустым: официальный SDK использует настроенный yc CLI.
# Альтернатива — краткоживущий IAM-токен только в локальной переменной окружения.
DATALENS_IAM_TOKEN=
# Необязательно: имя уже настроенного профиля yc.
DATALENS_YC_PROFILE=
